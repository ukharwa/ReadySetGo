# Local development settings. Copy to .env and adjust:
#   cp .env.example .env
# make and docker compose both read this file. Don't quote values.

# Environment: dev or prod. Required.
APP_ENV=dev

# The app's name, shown in pages and emails. Default: readysetgo.
APP_NAME=readysetgo
# The address users open the app at, used for links in emails: https in
# prod, no trailing path. Default in dev: http://localhost:8080.
# readysetgo:begin ui=api
# With a separate frontend, this is the frontend's address: the emailed
# links (/verify-email, /reset-password, /confirm-email, each with a ?token=)
# open there, and the frontend sends the token to the matching
# /api/auth/ endpoint.
# readysetgo:end
APP_URL=http://localhost:8080

# Address the HTTP server listens on. Default :8080 (all interfaces), which
# containers need; localhost keeps a dev server off your network.
HTTP_ADDR=localhost:8080

# Log output: text or json. Default: text in dev, json in prod.
LOG_FORMAT=text
# Lowest level logged: debug, info, warn or error. Default: info.
LOG_LEVEL=info

# After a shutdown signal, wait this long (with /readyz failing) before
# closing, so a load balancer stops sending traffic first. Default: 0s.
SHUTDOWN_DRAIN=0s
# Longest time in-flight requests get to finish during shutdown. Keep it
# below the container's stop timeout. Default: 25s.
SHUTDOWN_TIMEOUT=25s

# Proxies whose X-Forwarded-For header is believed when finding a client's
# IP (for rate limits and logs): comma-separated IPs or CIDR ranges. Set it
# to Caddy's address or network; never to a range clients can connect from.
# Default: empty, so the header is ignored.
TRUSTED_PROXIES=

# readysetgo:begin template
# (Template only: both blocks below are present until `make init`. The last
# DATABASE_URL wins, so the unpruned template runs on SQLite.)
# readysetgo:end
# readysetgo:begin db=postgres
# Postgres connection URL. Required. Holds a password: never commit a real one.
DATABASE_URL=postgres://readysetgo:readysetgo@localhost:5432/readysetgo?sslmode=disable
# Optional read replica. When set, read-only queries go here. Default: unset.
DATABASE_READ_URL=
# Connection pool, per instance and per URL. Postgres allows 100 connections
# by default, so keep instances × DB_MAX_OPEN_CONNS below that.
# Defaults: 25, 5m, 30m.
DB_MAX_OPEN_CONNS=25
DB_CONN_MAX_IDLE_TIME=5m
DB_CONN_MAX_LIFETIME=30m
# readysetgo:end
# readysetgo:begin db=sqlite
# Path to the SQLite database file; the file and its folder are created if
# missing. Required.
DATABASE_URL=data/readysetgo.db
# readysetgo:end
# Apply pending migrations when `serve` starts. Default: true.
MIGRATE_ON_START=true

# readysetgo:begin db=postgres
# Server used by the tests: each test gets its own copy of a migrated
# template database here. Only `make test` reads it.
TEST_DATABASE_URL=postgres://readysetgo:readysetgo@localhost:5432/postgres?sslmode=disable
# readysetgo:end

# Outgoing email. In dev, Mailpit (started by `make services`) catches every
# email in a web inbox at http://localhost:8025; leave SMTP_HOST empty to log
# emails instead. Prod requires a real server. SMTP_TLS is starttls (port
# 587), tls (port 465) or none (Mailpit, or a relay on the same machine).
# Defaults: port 587, starttls.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=readysetgo <noreply@example.com>
SMTP_TLS=none

# Shortest password allowed, 8 to 64. NIST's guidance is 15 when a password
# is the only way in. Default: 12.
PASSWORD_MIN_LENGTH=12

# Who can sign up: "open" (anyone) or "invite" (only people who were
# invited). `user invite EMAIL` sends an invitation.
# readysetgo:begin module=admin
# Admins can also send them from the users page.
# readysetgo:end
# readysetgo:begin module=workspaces
# An invitation to join a workspace counts too.
# readysetgo:end
# Default: open.
REGISTRATION=open

# Run the job worker (which sends email) inside `serve`. Set it to false when
# a separate `worker` process runs the jobs instead. Default: true.
WORKER_ENABLED=true
# Jobs one instance runs at the same time. Default: 4.
WORKER_CONCURRENCY=4
# readysetgo:begin module=uploads

# Folder for uploaded files. Every instance of the app must see the same
# folder (compose.yaml sets /data/uploads, on the data volume); back it up
# along with the database. Default: data/uploads.
UPLOADS_DIR=data/uploads
# readysetgo:end
# readysetgo:begin module=metrics

# Address for Prometheus metrics (/metrics) and Go's profiler
# (/debug/pprof/), served by `serve`. Never make it reachable from the
# internet: bind it to localhost, or in compose.yaml use :9090, which only
# containers on the stack's network (such as a Prometheus you add) can reach.
# Default: empty, which turns metrics off.
METRICS_ADDR=localhost:9090
# readysetgo:end
# readysetgo:begin module=errreport

# Where to report errors: a Sentry, GlitchTip or Bugsink project's DSN.
# Every error logged is reported. Default: empty, which turns reporting off.
SENTRY_DSN=
# readysetgo:end
# readysetgo:begin module=twofactor

# Encrypts two-factor login secrets in the database: 32 random bytes in
# base64, made with `openssl rand -base64 32`. Keep it with your other
# secrets and never change it: without it, everyone with two-factor login on
# must log in with a recovery code and set it up again. Required in prod;
# empty in dev uses a fixed development key.
TWO_FACTOR_KEY=
# readysetgo:end

# ---------------------------------------------------------------------------
# The production stack (compose.yaml): `make up` runs it locally, `make
# deploy` on a server. On the server, .env holds the production values of
# everything in this file. compose.yaml sets HTTP_ADDR, TRUSTED_PROXIES,
# APP_URL (https://APP_DOMAIN) and DATABASE_URL for the container itself.

# The domain Caddy serves and gets HTTPS certificates for. localhost makes
# Caddy use its own local certificate authority.
APP_DOMAIN=localhost
# Host ports Caddy listens on. Defaults: 80 and 443. Rootless Docker can't
# use ports below 1024: locally, use 8081 and 8443 (https://localhost:8443).
HTTP_PORT=80
HTTPS_PORT=443
# The image to run. Default: ghcr.io/ukharwa/readysetgo:latest, which CI
# pushes from main.
APP_IMAGE=
# readysetgo:begin db=postgres
# The database container's account. Use letters and digits in the password:
# it goes into a URL. Change it on the server.
POSTGRES_USER=readysetgo
POSTGRES_PASSWORD=readysetgo
POSTGRES_DB=readysetgo
# readysetgo:end
# readysetgo:begin db=sqlite
# Litestream: stream the database to S3-compatible storage. Turn it on with
# COMPOSE_PROFILES=litestream; see deploy/litestream.yml.
COMPOSE_PROFILES=
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# readysetgo:end
# `make deploy`: the server (user@host) and the folder there holding
# compose.yaml, deploy/ and the production .env.
DEPLOY_HOST=
DEPLOY_DIR=/srv/readysetgo

# Host ports for the dev services in compose.dev.yaml. Change them if another
# project's services already use these ports, and update the settings above
# that point at them. Defaults shown.
MAILPIT_SMTP_PORT=1025
MAILPIT_PORT=8025
# readysetgo:begin db=postgres
POSTGRES_PORT=5432
# readysetgo:end
