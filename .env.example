# Local development settings. Copy to .env and adjust:
#   cp .env.example .env
# make and docker compose both read this file. Don't quote values.

# Environment: dev or prod. Required.
APP_ENV=dev

# Address the HTTP server listens on. Default :8080 (all interfaces), which
# containers need; localhost keeps a dev server off your network.
HTTP_ADDR=localhost:8080

# Log output: text or json. Default: text in dev, json in prod.
LOG_FORMAT=text
# Lowest level logged: debug, info, warn or error. Default: info.
LOG_LEVEL=info

# After a shutdown signal, wait this long (with /readyz failing) before
# closing, so a load balancer stops sending traffic first. Default: 0s.
SHUTDOWN_DRAIN=0s
# Longest time in-flight requests get to finish during shutdown. Keep it
# below the container's stop timeout. Default: 25s.
SHUTDOWN_TIMEOUT=25s

# kickstart:begin template
# (Template only: both blocks below are present until `make init`. The last
# DATABASE_URL wins, so the unpruned template runs on SQLite.)
# kickstart:end
# kickstart:begin db=postgres
# Postgres connection URL. Required. Holds a password: never commit a real one.
DATABASE_URL=postgres://kickstart:kickstart@localhost:5432/kickstart?sslmode=disable
# Optional read replica. When set, read-only queries go here. Default: unset.
DATABASE_READ_URL=
# Connection pool, per instance and per URL. Postgres allows 100 connections
# by default, so keep instances × DB_MAX_OPEN_CONNS below that.
# Defaults: 25, 5m, 30m.
DB_MAX_OPEN_CONNS=25
DB_CONN_MAX_IDLE_TIME=5m
DB_CONN_MAX_LIFETIME=30m
# kickstart:end
# kickstart:begin db=sqlite
# Path to the SQLite database file; the file and its folder are created if
# missing. Required.
DATABASE_URL=data/kickstart.db
# kickstart:end
# Apply pending migrations when `serve` starts. Default: true.
MIGRATE_ON_START=true

# kickstart:begin db=postgres
# Server used by the tests: each test gets its own copy of a migrated
# template database here. Only `make test` reads it.
TEST_DATABASE_URL=postgres://kickstart:kickstart@localhost:5432/postgres?sslmode=disable
# kickstart:end
